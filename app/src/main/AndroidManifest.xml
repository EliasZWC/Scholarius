<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        应用内更新：下载完新包后要拉起系统安装器。
        Android 8.0 起必须声明它，且系统仍会弹一次「允许安装未知应用」让用户确认。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        ⚠️ 包可见性（Android 11 / API 30 起）。

        登录时要「优先用 GitHub App 打开授权页」，靠的是
        `packageManager.queryIntentActivities()` 与 `getApplicationInfo()`。
        API 30 起，除非显式声明可见性，否则这两个 API
        **只能看到系统浏览器这类默认可见的包** —— GitHub App 会被直接过滤掉。

        实测证据（v0.0.15 真机日志）：
            com.github.android 已安装=false        ← getApplicationInfo 查不到
            能处理该链接的 App 共 1 个：
              · com.android.chrome/...             ← 只剩浏览器
            没找到 GitHub App → 退回浏览器

        两种声明方式都要用，它们覆盖不同情况：

          ① `<package>` —— 直接点名。最可靠，且不依赖对方注册了什么 intent filter。
             用于「我知道要这个包，就是要查它装没装」。
          ② `<intent>` —— 按能力查询。用于「谁都能接住 github.com 我就认谁」，
             覆盖用户装了第三方 GitHub 客户端的情况。

        不用 QUERY_ALL_PACKAGES —— 那是敏感权限，上架要额外说明，且没必要。
    -->
    <queries>
        <!-- ① 点名：GitHub 官方 App -->
        <package android:name="com.github.android" />
        <package android:name="com.github.android.beta" />

        <!-- ② 按能力：能浏览 https 的 App -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!-- ③ 按能力：GitHub App 自定义 scheme（部分版本用它做深链） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="github" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scholarius">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Scholarius.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            把下载好的更新包以 content:// 形式交给系统安装器。
            Android 7 起禁止直接传 file://（会抛 FileUriExposedException）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
