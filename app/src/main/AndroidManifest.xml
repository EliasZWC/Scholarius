<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        应用内更新：下载完新包后要拉起系统安装器。
        Android 8.0 起必须声明它，且系统仍会弹一次「允许安装未知应用」让用户确认。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        ⚠️ 包可见性（Android 11 / API 30 起）。

        登录时要「优先用 GitHub App 打开授权页」，靠的是
        `packageManager.queryIntentActivities()` 列出所有能处理该 https 链接的 App。
        API 30 起，除非显式声明可见性，否则 queryIntentActivities() **只能看到
        系统浏览器这类默认可见的包** —— GitHub App 会被直接过滤掉，
        于是永远挑不到它、每次都退回浏览器。

        这正是「GitHub App 明明装了却只打开浏览器」的原因。

        这里声明「我要查询能浏览 https 链接的 App」，让 GitHub App 出现在结果里。
        不用 QUERY_ALL_PACKAGES —— 那是敏感权限，上架要额外说明，且完全没必要。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scholarius">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Scholarius.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            把下载好的更新包以 content:// 形式交给系统安装器。
            Android 7 起禁止直接传 file://（会抛 FileUriExposedException）。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
