{
  "root": true,
  "env": { "browser": true, "es2020": true },
  "parserOptions": { "ecmaVersion": 2020, "sourceType": "script" },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-redeclare": "error"
  },
  "globals": {
    "module": "writable"
  }
}
